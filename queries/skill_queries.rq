# QUERY: all_skills
PREFIX : <http://example.org/employee#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?skillName
WHERE {
    ?skill rdf:type :Skill .
    ?skill :skillName ?skillName .
}
ORDER BY ?skillName

